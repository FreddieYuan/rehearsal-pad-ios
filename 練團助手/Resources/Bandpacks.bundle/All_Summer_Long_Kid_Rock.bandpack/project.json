  "lyrics": [
    {
      "start": 20.97,
      "end": 25.94,
      "text": "It was 1989, my thoughts were short my hair was long",
      "source": "imported"
    },
    {
      "start": 25.94,
      "end": 30.99,
      "text": "Caught somewhere between a boy and man",
      "source": "imported"
    },
    {
      "start": 30.99,
      "end": 35.36,
      "text": "She was seventeen and she was far from in-between",
      "source": "imported"
    },
    {
      "start": 35.36,
      "end": 40.77,
      "text": "It was summertime in Northern Michigan",
      "source": "imported"
    },
    {
      "start": 40.77,
      "end": 45.37,
      "text": "Ahh Ahh Ahh",
      "source": "imported"
    },
    {
      "start": 45.37,
      "end": 49.76,
      "text": "Ahh Ahh Ahh",
      "source": "imported"
    },
    {
      "start": 49.76,
      "end": 51.96,
      "text": "Splashing through the sand bar",
      "source": "imported"
    },
    {
      "start": 51.96,
      "end": 54.14,
      "text": "Talking by the campfire",
      "source": "imported"
    },
    {
      "start": 54.14,
      "end": 59.15,
      "text": "It's the simple things in life, like when and where",
      "source": "imported"
    },
    {
      "start": 59.15,
      "end": 61.21,
      "text": "We didn't have no internet",
      "source": "imported"
    },
    {
      "start": 61.21,
      "end": 63.79,
      "text": "But man I never will forget",
      "source": "imported"
    },
    {
      "start": 63.79,
      "end": 67.82,
      "text": "The way the moonlight shined upon her hair",
      "source": "imported"
    },
    {
      "start": 67.82,
      "end": 70.03,
      "text": "And we were trying different things",
      "source": "imported"
    },
    {
      "start": 70.03,
      "end": 72.39,
      "text": "We were smoking funny things",
      "source": "imported"
    },
    {
      "start": 72.39,
      "end": 77.27,
      "text": "Making love out by the lake to our favorite song",
      "source": "imported"
    },
    {
      "start": 77.27,
      "end": 81.94,
      "text": "Sipping whiskey out the bottle, not thinking 'bout tomorrow",
