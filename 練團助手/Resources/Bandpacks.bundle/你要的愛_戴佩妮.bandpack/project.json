  "lyrics": [
    {
      "start": 1.13,
      "end": 7.699,
      "text": "雖然經常夢見你",
      "source": "imported"
    },
    {
      "start": 7.699,
      "end": 11.339,
      "text": "還是毫無頭緒",
      "source": "imported"
    },
    {
      "start": 11.339,
      "end": 15.59,
      "text": "外面正在下著雨",
      "source": "imported"
    },
    {
      "start": 15.59,
      "end": 18.299,
      "text": "今天是星期幾",
      "source": "imported"
    },
    {
      "start": 18.299,
      "end": 20.819,
      "text": "But I don`t know",
      "source": "imported"
    },
    {
      "start": 20.819,
      "end": 26.959,
      "text": "你去那裡",
      "source": "imported"
    },
    {
      "start": 26.959,
      "end": 33.8,
      "text": "雖然不曾懷疑你",
      "source": "imported"
    },
    {
      "start": 33.8,
      "end": 39.88,
      "text": "還是忐忑不定",
      "source": "imported"
    },
    {
      "start": 39.88,
      "end": 43.68,
      "text": "誰是你的那個唯一",
      "source": "imported"
    },
    {
      "start": 43.68,
      "end": 49.68,
      "text": "原諒我懷疑自己",
      "source": "imported"
    },
    {
      "start": 49.68,
      "end": 53.2,
      "text": "我明白",
      "source": "imported"
    },
    {
      "start": 53.2,
      "end": 56.16,
      "text": "我要的愛",
      "source": "imported"
    },
    {
      "start": 56.16,
      "end": 60.61,
      "text": "會把我寵壞",
      "source": "imported"
    },
    {
      "start": 60.61,
      "end": 62.15,
      "text": "像一個小孩",
      "source": "imported"
    },
    {
      "start": 62.15,
      "end": 66.6,
      "text": "只懂在你懷裡壞",
      "source": "imported"
    },
    {
      "start": 66.6,
      "end": 69.3,
      "text": "你要的愛",
      "source": "imported"
    },
    {
      "start": 69.3,
      "end": 73.48,
      "text": "不只是依賴",
      "source": "imported"
    },
    {
      "start": 73.48,
      "end": 75.7,
      "text": "要像個大男孩",
      "source": "imported"
    },
    {
      "start": 75.7,
      "end": 76.73,
      "text": "風吹又日曬",
      "source": "imported"
    },
    {
      "start": 76.73,
      "end": 79.73,
      "text": "生活自由自在",
      "source": "imported"
    },
