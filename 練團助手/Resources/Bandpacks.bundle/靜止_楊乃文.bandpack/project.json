  "lyrics": [
    {
      "start": 14.164172642857142,
      "end": 28.328345285714285,
      "text": "寂寞圍繞著電視 垂死堅持 在兩點半消失 多希望有人來陪我 度過末日",
      "source": "manual"
    },
    {
      "start": 28.328345285714285,
      "end": 42.49251792857143,
      "text": "空虛敲打著意志 彷彿這時間已靜止 我懷疑人們的生活 有所掩飾",
      "source": "manual"
    },
    {
      "start": 42.49251792857143,
      "end": 56.65669057142857,
      "text": "啊~ 啊~ 啊~~~ 垂死堅持 啊~ 啊~ 啊~~~ 已靜止",
      "source": "manual"
    },
    {
      "start": 70.82086321428571,
      "end": 84.98503585714286,
      "text": "衝動在瞬間消失 夢被稀釋 不停轉動著手指 我幻想美麗的生活 何時開始",
      "source": "manual"
    },
    {
      "start": 84.98503585714286,
      "end": 99.1492085,
      "text": "時光不經意流逝 像顆在耗費的電池 我感到有點失落 無法抑制",
      "source": "manual"
    },
    {
      "start": 99.1492085,
      "end": 113.31338114285714,
      "text": "啊~ 啊~ 啊~~~ 垂死堅持 啊~ 啊~ 啊~~~ 已靜止",
