  "lyrics": [
    {
      "start": 11.87,
      "end": 15.31,
      "text": "i hear the ticking of the clock",
      "source": "imported"
    },
    {
      "start": 15.31,
      "end": 21.54,
      "text": "I'm lying here the room's pitch dark",
      "source": "imported"
    },
    {
      "start": 21.54,
      "end": 26.11,
      "text": "I wonder where you are tonight",
      "source": "imported"
    },
    {
      "start": 26.11,
      "end": 32.44,
      "text": "No answer on the telephone",
      "source": "imported"
    },
    {
      "start": 32.44,
      "end": 37.23,
      "text": "And the night goes by so very slow",
      "source": "imported"
    },
    {
      "start": 37.23,
      "end": 42.88,
      "text": "Oh i hope that it won't end though",
      "source": "imported"
    },
    {
      "start": 42.88,
      "end": 50.32,
      "text": "Alone",
      "source": "imported"
    },
    {
      "start": 50.32,
      "end": 56.45,
      "text": "Till now i always got by on my own",
      "source": "imported"
    },
    {
      "start": 56.45,
      "end": 61.57,
      "text": "I never really cared until i met you",
      "source": "imported"
    },
    {
      "start": 61.57,
      "end": 66.6,
      "text": "And now it chills me to the bone",
      "source": "imported"
    },
    {
      "start": 66.6,
      "end": 71.25,
      "text": "How do i get you alone",
      "source": "imported"
    },
    {
      "start": 71.25,
      "end": 79.25,
      "text": "How do i get you alone",
      "source": "imported"
    },
    {
      "start": 80.57,
      "end": 84.16,
      "text": "You don't know how long i have wanted",
      "source": "imported"
    },
    {
      "start": 84.16,
      "end": 91.44,
      "text": "To touch your lips and hold you tight",
      "source": "imported"
    },
    {
      "start": 91.44,
      "end": 94.71000000000001,
      "text": "You don't know how long i have waited",
