  "lyrics": [
    {
      "start": 19.25,
      "end": 21.09,
      "text": "一隻哀傷的貓",
      "source": "imported"
    },
    {
      "start": 21.09,
      "end": 28.54,
      "text": "倚著鐵窗舔著打架後的傷",
      "source": "imported"
    },
    {
      "start": 28.54,
      "end": 30.69,
      "text": "一張白色床單",
      "source": "imported"
    },
    {
      "start": 30.69,
      "end": 38.63,
      "text": "皺成一團不知所云的凌亂",
      "source": "imported"
    },
    {
      "start": 38.63,
      "end": 43.38,
      "text": "誰的菸頭 儘管囂張",
      "source": "imported"
    },
    {
      "start": 43.38,
      "end": 48.22,
      "text": "擴散理不亂還亂的貪婪",
      "source": "imported"
    },
    {
      "start": 48.22,
      "end": 53.2,
      "text": "誰撐的傘 一點溫暖",
      "source": "imported"
    },
    {
      "start": 53.2,
      "end": 59.68,
      "text": "究竟是天堂還是苦難",
      "source": "imported"
    },
    {
      "start": 59.68,
      "end": 61.69,
      "text": "在懸崖的頂端",
      "source": "imported"
    },
    {
      "start": 61.69,
      "end": 69.23,
      "text": "時間總是過得比時鐘還慢",
      "source": "imported"
    },
    {
      "start": 69.23,
      "end": 71.27,
      "text": "一旦汗被風乾",
      "source": "imported"
    },
    {
      "start": 71.27,
      "end": 76.77,
      "text": "包著皮膚一層隱形的惆悵",
      "source": "imported"
    },
    {
      "start": 79.61,
      "end": 84.05,
      "text": "誰的情感 無法張揚",
      "source": "imported"
    },
    {
      "start": 84.05,
      "end": 88.89,
      "text": "誰在陌生的房故作勇敢",
      "source": "imported"
    },
    {
      "start": 88.89,
      "end": 93.55,
      "text": "誰在夜晚 害怕腐爛",
      "source": "imported"
    },
    {
      "start": 93.55,
      "end": 101.18,
      "text": "任呼吸突然變得野蠻",
      "source": "imported"
    },
    {
      "start": 101.18,
      "end": 106.69,
      "text": "先愛吧 霸佔一副肩膀",
      "source": "imported"
    },
    {
      "start": 106.69,
      "end": 111.22999999999999,
      "text": "擋掉一點 遺憾",
      "source": "imported"
    },
    {
      "start": 111.22999999999999,
      "end": 116.02000000000001,
      "text": "先愛吧 啃噬一雙翅膀",
      "source": "imported"
    },
    {
      "start": 116.02000000000001,
      "end": 120.77,
      "text": "多熬過一季黑暗",
      "source": "imported"
    },
    {
      "start": 120.77,
      "end": 124.34,
      "text": "先愛吧 動物不都這樣",
      "source": "imported"
    },
    {
      "start": 124.34,
      "end": 127.79,
      "text": "一旦慾求不滿",
      "source": "imported"
    },
    {
      "start": 127.79,
      "end": 135.26,
      "text": "先愛吧 之後感傷",
      "source": "imported"
    },
    {
      "start": 135.26,
      "end": 137.26,
      "text": "之後再算",
      "source": "imported"
    },
    {
      "start": 156.16,
      "end": 158.84,
      "text": "是要點膽量",
      "source": "imported"
    },
    {
      "start": 158.84,
      "end": 165.5,
      "text": "還是真的要對生活感到煩",
      "source": "imported"
    },
    {
      "start": 165.5,
      "end": 167.74,
      "text": "天台望下的窗",
      "source": "imported"
    },
    {
      "start": 167.74,
      "end": 175.62,
      "text": "又有哪扇抱著滿足入夢鄉",
      "source": "imported"
    },
