    },
    {
      "start": 43.18,
      "end": 48.39,
      "text": "明日（あした）の 今頃（いまごろ）には",
      "source": "imported"
    },
    {
      "start": 48.39,
      "end": 55.41,
      "text": "あなたはどこにいるんだろう",
