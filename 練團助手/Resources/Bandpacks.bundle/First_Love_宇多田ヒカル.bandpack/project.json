    },
    {
      "start": 64.95,
      "end": 68.68,
      "text": "You are always gonna be my love",
      "source": "imported"
    },
    {
      "start": 68.68,
      "end": 75.63,
      "text": "いつか誰（だれ）かとまた戀（こい）に落（お）ちても",
