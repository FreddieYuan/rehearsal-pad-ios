  "lyrics": [
    {
      "start": 18.466,
      "end": 25.11,
      "text": "今天我 寒夜裡看雪飄過",
      "source": "imported"
    },
    {
      "start": 25.11,
      "end": 30.95,
      "text": "懷著冷卻了的心窩漂遠方",
      "source": "imported"
    },
    {
      "start": 30.95,
      "end": 37.229,
      "text": "風雨裡追趕 霧裡分不清影蹤",
      "source": "imported"
    },
    {
      "start": 37.229,
      "end": 40.291,
      "text": "天空海闊你與我",
      "source": "imported"
    },
    {
      "start": 40.291,
      "end": 43.44,
      "text": "可會變 (誰沒在變)",
      "source": "imported"
    },
    {
      "start": 43.44,
      "end": 50.05,
      "text": "多少次 迎著冷眼與嘲笑",
      "source": "imported"
    },
    {
      "start": 50.05,
      "end": 55.907,
      "text": "從沒有放棄過心中的理想",
      "source": "imported"
    },
    {
      "start": 55.907,
      "end": 62.133,
      "text": "一剎那恍惚 若有所失的感覺",
      "source": "imported"
    },
    {
      "start": 62.133,
      "end": 65.243,
      "text": "不知不覺已變淡",
      "source": "imported"
    },
    {
      "start": 65.243,
      "end": 68.801,
      "text": "心裡愛 (誰明白我)",
      "source": "imported"
    },
    {
      "start": 68.801,
      "end": 75.799,
      "text": "原諒我這一生不羈放縱愛自由",
      "source": "imported"
    },
    {
      "start": 75.799,
      "end": 82.008,
      "text": "也會怕有一天會跌倒",
      "source": "imported"
    },
    {
      "start": 82.008,
      "end": 88.276,
      "text": "背棄了理想 誰人都可以",
      "source": "imported"
    },
    {
      "start": 88.276,
      "end": 93.276,
      "text": "哪會怕有一天只你共我",
      "source": "imported"
    },
    {
