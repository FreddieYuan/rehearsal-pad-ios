  "lyrics": [
    {
      "start": 19.84,
      "end": 27.84,
      "text": "I belong, a long way from here",
      "source": "imported"
    },
    {
      "start": 30.89,
      "end": 35.488,
      "text": "I put on a poncho and played for mosquitoes",
      "source": "imported"
    },
    {
      "start": 35.488,
      "end": 39.955,
      "text": "And drank 'till I was thirsty again",
      "source": "imported"
    },
    {
      "start": 39.955,
      "end": 47.955,
      "text": "We went searching, through thrift store jungles",
      "source": "imported"
    },
    {
      "start": 50.195,
      "end": 55.654,
      "text": "Found Geronimo's rifle, Marilyn's shampoo",
      "source": "imported"
    },
    {
      "start": 55.654,
      "end": 60.069,
      "text": "And Benny Goodman's cursive pen",
      "source": "imported"
    },
    {
      "start": 60.069,
      "end": 65.738,
      "text": "Well, okay, I made this up",
      "source": "imported"
    },
    {
      "start": 65.738,
      "end": 69.055,
      "text": "I promise you I'd never give up",
      "source": "imported"
    },
    {
      "start": 69.055,
      "end": 74.541,
      "text": "If it makes you happy",
      "source": "imported"
    },
    {
      "start": 74.541,
      "end": 79.191,
      "text": "It can't be that bad",
      "source": "imported"
    },
    {
      "start": 79.191,
      "end": 83.945,
      "text": "If it makes you happy",
      "source": "imported"
    },
    {
      "start": 83.945,
      "end": 91.945,
      "text": "Then why the hell are you so sad?",
      "source": "imported"
    },
    {
      "start": 95.596,
      "end": 103.596,
      "text": "Get down, real low down",
      "source": "imported"
    },
    {
      "start": 105.96600000000001,
      "end": 111.00800000000001,
      "text": "You listen to Coltrane, derail your own train",
      "source": "imported"
    },
    {
      "start": 111.00800000000001,
      "end": 115.37,
      "text": "Well, who hasn't been there before?",
      "source": "imported"
    },
    {
      "start": 115.37,
      "end": 123.37,
      "text": "I come 'round, around the hard way",
      "source": "imported"
    },
    {
      "start": 125.767,
      "end": 128.066,
      "text": "Bring you comics in bed",
      "source": "imported"
    },
    {
      "start": 128.066,
      "end": 131.122,
      "text": "Scrape the mold off the bread",
      "source": "imported"
    },
    {
      "start": 131.122,
      "end": 135.563,
      "text": "And serve you french toast again",
      "source": "imported"
    },
    {
      "start": 135.563,
      "end": 141.258,
      "text": "Okay, I still get stoned",
      "source": "imported"
    },
    {
      "start": 141.258,
      "end": 144.941,
      "text": "I'm not the kind of girl you'd take home",
      "source": "imported"
    },
    {
      "start": 144.941,
      "end": 149.956,
      "text": "If it makes you happy",
