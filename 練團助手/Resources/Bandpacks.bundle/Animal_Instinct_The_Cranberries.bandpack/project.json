  "lyrics": [
    {
      "start": 14.545454545454545,
      "end": 20.0,
      "text": "Suddenly something has happened to me",
      "source": "manual"
    },
    {
      "start": 20.0,
      "end": 23.636363636363637,
      "text": "As I was having my cup of tea",
      "source": "manual"
    },
    {
      "start": 23.636363636363637,
      "end": 27.272727272727273,
      "text": "Suddenly I was feeling depressed",
      "source": "manual"
    },
    {
      "start": 27.272727272727273,
      "end": 30.90909090909091,
      "text": "I was utterly and totally stressed",
      "source": "manual"
    },
    {
      "start": 30.90909090909091,
      "end": 38.18181818181818,
      "text": "Do you know you made me cry, oh",
      "source": "manual"
    },
    {
      "start": 38.18181818181818,
      "end": 43.63636363636363,
      "text": "Do you know you made me die",
      "source": "manual"
    },
    {
      "start": 43.63636363636363,
      "end": 47.272727272727266,
      "text": "And the thing that gets to me",
      "source": "manual"
    },
    {
      "start": 47.272727272727266,
      "end": 50.9090909090909,
      "text": "Is you'll never really see",
      "source": "manual"
    },
    {
      "start": 50.9090909090909,
      "end": 54.54545454545453,
      "text": "And the thing that freaks me out",
      "source": "manual"
    },
    {
      "start": 54.54545454545453,
      "end": 59.999999999999986,
      "text": "Is I'll always be in doubt",
      "source": "manual"
    },
    {
      "start": 59.999999999999986,
      "end": 63.63636363636362,
      "text": "It is a lovely thing that we have",
      "source": "manual"
    },
    {
      "start": 63.63636363636362,
      "end": 67.27272727272725,
      "text": "It is a lovely thing that we",
      "source": "manual"
    },
    {
      "start": 67.27272727272725,
      "end": 72.7272727272727,
      "text": "It is a lovely thing, the animal",
      "source": "manual"
    },
    {
      "start": 72.7272727272727,
      "end": 76.36363636363635,
      "text": "The animal instinct",
      "source": "manual"
    },
    {
      "start": 76.36363636363635,
      "end": 83.63636363636361,
      "text": "Ooh",
      "source": "manual"
    },
    {
      "start": 90.90909090909088,
      "end": 96.36363636363633,
      "text": "So take my hands and come with me",
      "source": "manual"
    },
    {
      "start": 96.36363636363633,
      "end": 99.99999999999997,
      "text": "We will change reality",
      "source": "manual"
    },
    {
      "start": 99.99999999999997,
      "end": 103.63636363636361,
      "text": "So take my hands and we will pray",
      "source": "manual"
    },
    {
      "start": 103.63636363636361,
      "end": 107.27272727272725,
      "text": "They won't take you away",
      "source": "manual"
    },
    {
      "start": 107.27272727272725,
      "end": 114.54545454545452,
      "text": "They will never make me cry, no",
      "source": "manual"
    },
    {
      "start": 114.54545454545452,
      "end": 118.18181818181816,
      "text": "They will never make me die",
      "source": "manual"
    },
    {
      "start": 118.18181818181816,
      "end": 121.8181818181818,
      "text": "And the thing that gets to me",
      "source": "manual"
    },
    {
      "start": 121.8181818181818,
      "end": 125.45454545454544,
      "text": "Is you'll never really see",
      "source": "manual"
    },
    {
      "start": 125.45454545454544,
      "end": 129.09090909090907,
      "text": "And the thing that freaks me out",
      "source": "manual"
    },
    {
      "start": 129.09090909090907,
      "end": 132.7272727272727,
      "text": "Is I'll always be in doubt",
      "source": "manual"
    },
    {
      "start": 132.7272727272727,
      "end": 139.99999999999997,
      "text": "The animal, the animal, the animal instinct in me",
      "source": "manual"
    },
    {
      "start": 139.99999999999997,
      "end": 147.27272727272725,
      "text": "It's the animal, the animal, the animal instinct in me",
      "source": "manual"
    },
    {
      "start": 147.27272727272725,
      "end": 154.54545454545453,
      "text": "It's the animal, it's the animal, it's the animal instinct in me",
      "source": "manual"
    },
    {
      "start": 154.54545454545453,
      "end": 161.8181818181818,
      "text": "It's the animal, it's the animal, it's the animal instinct in me",
      "source": "manual"
