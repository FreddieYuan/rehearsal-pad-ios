  "lyrics": [
    {
      "start": 19.199999999999996,
      "end": 23.999999999999996,
      "text": "Kiss me out of the bearded barley,",
      "source": "manual"
    },
    {
      "start": 23.999999999999996,
      "end": 28.799999999999997,
      "text": "Nightly, beside the green, green grass",
      "source": "manual"
    },
    {
      "start": 28.799999999999997,
      "end": 33.599999999999994,
      "text": "Swing, swing, swing the spinning step",
      "source": "manual"
    },
    {
      "start": 33.599999999999994,
      "end": 35.99999999999999,
      "text": "You'll wear those shoes",
      "source": "manual"
    },
    {
      "start": 35.99999999999999,
      "end": 38.39999999999999,
      "text": "And I will wear that dress",
      "source": "manual"
    },
    {
      "start": 38.39999999999999,
      "end": 47.99999999999999,
      "text": "Oh, kiss me beneath the milky twilight",
      "source": "manual"
    },
    {
      "start": 47.99999999999999,
      "end": 59.99999999999999,
      "text": "Lead me out on the moonlit floor",
