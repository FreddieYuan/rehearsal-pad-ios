  "lyrics": [
    {
      "start": 20,
      "end": 29,
      "text": "黑暗裡誰冷眼的張望",
      "source": "manual"
    },
    {
      "start": 29,
      "end": 39,
      "text": "繼續或放棄有什麼不一樣",
      "source": "manual"
    },
    {
      "start": 39,
      "end": 48,
      "text": "別在耳邊說著天真的謊",
      "source": "manual"
    },
    {
      "start": 48,
      "end": 58,
      "text": "安慰抵不上　痛哭一場",
      "source": "manual"
    },
    {
      "start": 58,
      "end": 67,
      "text": "失望的墮落的浮躁的不安",
      "source": "manual"
    },
    {
      "start": 67,
      "end": 76,
      "text": "分裂的冷酷的誰的憂傷　被解放",
      "source": "manual"
    },
    {
      "start": 76,
      "end": 84,
      "text": "沸騰的擁擠的喧嘩的熱情",
      "source": "manual"
    },
    {
      "start": 84,
      "end": 92,
      "text": "放肆的忘情的昨天所有的快樂　都遺忘",
      "source": "manual"
    },
    {
      "start": 92,
      "end": 99,
      "text": "Because she knows",
      "source": "manual"
    },
    {
      "start": 99,
      "end": 106,
      "text": "Don't wanna be your angel",
      "source": "manual"
    },
    {
      "start": 106,
      "end": 114,
      "text": "不想背著一副黑色的翅膀",
      "source": "manual"
    },
    {
      "start": 114,
      "end": 120,
      "text": "She knows",
      "source": "manual"
    },
    {
      "start": 120,
      "end": 126,
      "text": "Nothing can last forever",
      "source": "manual"
    },
    {
      "start": 126,
      "end": 128,
      "text": "她的心只懂得真實的模樣",
      "source": "manual"
    },
    {
      "start": 138,
      "end": 148,
      "text": "Da di li da li la la...",
      "source": "manual"
    },
    {
      "start": 148,
      "end": 158,
      "text": "破曉的陽光落肩上",
      "source": "manual"
    },
    {
      "start": 158,
      "end": 168,
      "text": "張開眼的人懂得自由飛翔",
      "source": "manual"
    },
    {
      "start": 168,
      "end": 178,
      "text": "不需要誰支撐的力量",
      "source": "manual"
    },
    {
      "start": 178,
      "end": 188,
      "text": "一個人走到最遠的地方",
      "source": "manual"
    },
    {
      "start": 188,
      "end": 196,
      "text": "失望的墮落的浮躁的不安",
      "source": "manual"
    },
    {
      "start": 196,
      "end": 204,
      "text": "分裂的冷酷的誰的憂傷　被解放",
      "source": "manual"
    },
    {
      "start": 204,
      "end": 212,
      "text": "Because she knows",
      "source": "manual"
    },
    {
      "start": 212,
      "end": 220,
      "text": "Don't wanna be your angel",
      "source": "manual"
    },
    {
      "start": 220,
      "end": 226,
      "text": "不想背著一副黑色的翅膀",
      "source": "manual"
    },
    {
      "start": 226,
      "end": 232,
      "text": "她的心只懂得真實的模樣",
      "source": "manual"
    },
    {
      "start": 240,
      "end": 242.0,
      "text": "She knows!!",
      "source": "manual"
