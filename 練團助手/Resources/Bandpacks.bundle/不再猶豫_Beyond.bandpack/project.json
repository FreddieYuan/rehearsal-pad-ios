    {
      "start": 28.74,
      "end": 32.25,
      "text": "無聊望見了猶豫",
      "source": "imported"
    },
    {
      "start": 32.25,
      "end": 35.85,
      "text": "達到理想不太易",
      "source": "imported"
    },
    {
      "start": 35.85,
      "end": 38.07,
      "text": "即使有信心",
      "source": "imported"
    },
    {
      "start": 38.07,
      "end": 42.99,
      "text": "鬥志卻抑止",
      "source": "imported"
    },
    {
      "start": 42.99,
      "end": 45.33,
      "text": "誰人定我去或留",
      "source": "imported"
    },
    {
      "start": 45.33,
      "end": 50.19,
      "text": "定我心中的宇宙",
      "source": "imported"
    },
    {
      "start": 50.19,
      "end": 52.32,
      "text": "只想靠兩手",
      "source": "imported"
    },
    {
      "start": 52.32,
      "end": 57.36,
      "text": "向理想揮手",
      "source": "imported"
    },
    {
      "start": 57.36,
      "end": 59.01,
      "text": "問句天幾高",
      "source": "imported"
    },
    {
      "start": 59.01,
      "end": 64.59,
      "text": "心中志比天更高",
      "source": "imported"
    },
    {
      "start": 64.59,
      "end": 71.93,
      "text": "自信打不死的心態活到老",
      "source": "imported"
    },
    {
      "start": 71.93,
      "end": 75.32900000000001,
      "text": "Woo ho",
      "source": "imported"
    },
    {
      "start": 75.32900000000001,
      "end": 78.87,
      "text": "我有我心底故事",
      "source": "imported"
    },
    {
      "start": 78.87,
      "end": 81.09,
      "text": "親手寫上每段",
      "source": "imported"
    },
    {
      "start": 81.09,
      "end": 86.05,
      "text": "得失樂與悲與夢兒",
