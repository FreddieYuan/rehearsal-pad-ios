  "lyrics": [
    {
      "start": 16.07,
      "end": 21.35,
      "text": "有多久沒見你",
      "source": "imported"
    },
    {
      "start": 21.35,
      "end": 27.53,
      "text": "以為你在那裡",
      "source": "imported"
    },
    {
      "start": 27.53,
      "end": 33.15,
      "text": "原來就住在我心底",
      "source": "imported"
    },
    {
      "start": 33.15,
      "end": 38.78,
      "text": "陪伴著我的呼吸",
      "source": "imported"
    },
    {
      "start": 38.78,
      "end": 43.2,
      "text": "有多遠的距離",
      "source": "imported"
    },
    {
      "start": 43.2,
      "end": 50.08,
      "text": "以為 聞不到你氣息",
      "source": "imported"
    },
    {
      "start": 50.08,
      "end": 56.18,
      "text": "誰知道你背影這麼長",
      "source": "imported"
    },
    {
      "start": 56.18,
      "end": 61.76,
      "text": "回頭就看到你",
      "source": "imported"
    },
    {
      "start": 61.76,
      "end": 65.94,
      "text": "過去讓它過去",
      "source": "imported"
    },
    {
      "start": 65.94,
      "end": 68.03999999999999,
      "text": "來不及",
      "source": "imported"
    },
    {
      "start": 68.03999999999999,
      "end": 71.95,
      "text": "從頭喜歡你",
      "source": "imported"
    },
    {
      "start": 71.95,
      "end": 76.92,
      "text": "白雲纏繞著藍天",
      "source": "imported"
    },
    {
      "start": 76.92,
      "end": 82.1,
      "text": "如果不能夠永遠走在一起",
      "source": "imported"
    },
    {
      "start": 82.1,
      "end": 87.55,
      "text": "也至少給我們",
      "source": "imported"
    },
    {
      "start": 87.55,
      "end": 91.09,
      "text": "懷念的勇氣",
      "source": "imported"
    },
    {
      "start": 91.09,
      "end": 93.8,
      "text": "擁抱的權利",
      "source": "imported"
    },
    {
      "start": 93.8,
      "end": 97.62,
      "text": "好讓你明白",
      "source": "imported"
    },
    {
      "start": 97.62,
      "end": 100.62,
      "text": "我心動的痕跡",
      "source": "imported"
    },
    {
