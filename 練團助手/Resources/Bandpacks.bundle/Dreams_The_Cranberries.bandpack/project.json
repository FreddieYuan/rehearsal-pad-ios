  "lyrics": [
    {
      "start": 33.53,
      "end": 41.47,
      "text": "Oh, my life is changing everyday,",
      "source": "imported"
    },
    {
      "start": 41.47,
      "end": 48.92,
      "text": "In every possible way.",
      "source": "imported"
    },
    {
      "start": 48.92,
      "end": 52.5,
      "text": "And oh, my dreams,",
      "source": "imported"
    },
    {
      "start": 52.5,
      "end": 55.32,
      "text": "it's never quiet as it seems,",
      "source": "imported"
    },
    {
      "start": 55.32,
      "end": 61.3,
      "text": "Never quiet as it seems.",
      "source": "imported"
    },
    {
      "start": 61.3,
      "end": 66.63,
      "text": "I know I've felt like this before,",
      "source": "imported"
    },
    {
      "start": 66.63,
      "end": 71.22,
      "text": "but now I'm feeling it even more,",
      "source": "imported"
    },
    {
      "start": 71.22,
      "end": 78.03999999999999,
      "text": "Because it came from you.",
      "source": "imported"
    },
    {
      "start": 78.03999999999999,
      "end": 80.42,
      "text": "And then I open up and see",
      "source": "imported"
    },
    {
      "start": 80.42,
      "end": 85.6,
      "text": "the person falling here is me,",
      "source": "imported"
    },
    {
      "start": 85.6,
      "end": 92.85,
      "text": "A different way to be.",
      "source": "imported"
    },
    {
      "start": 92.85,
      "end": 98.64,
      "text": "Ah, la da ah...",
      "source": "imported"
    },
    {
      "start": 98.64,
      "end": 101.14,
      "text": "La...",
      "source": "imported"
    },
    {
      "start": 109.5,
      "end": 115.31,
      "text": "I want more imposible to ignore,",
      "source": "imported"
    },
    {
      "start": 115.31,
      "end": 123.31,
      "text": "Imposible to ignore.",
      "source": "imported"
    },
    {
      "start": 123.92,
      "end": 127.03,
      "text": "And they'll come true,",
      "source": "imported"
    },
    {
      "start": 127.03,
      "end": 130.58,
      "text": "impossible not to do,",
      "source": "imported"
    },
    {
      "start": 130.58,
      "end": 137.94,
      "text": "Impossible not to do.",
      "source": "imported"
    },
    {
      "start": 137.94,
      "end": 141.32,
      "text": "And now I tell you openly,",
      "source": "imported"
    },
    {
      "start": 141.32,
      "end": 145.82,
      "text": "you have my heart so don't hurt me.",
      "source": "imported"
    },
    {
      "start": 145.82,
      "end": 151.82999999999998,
      "text": "You're what I couldn't find.",
      "source": "imported"
    },
    {
      "start": 151.82999999999998,
      "end": 156.18,
      "text": "A totally amazing mind,",
      "source": "imported"
    },
    {
      "start": 156.18,
      "end": 160.81,
      "text": "so understanding and so kind;",
      "source": "imported"
    },
    {
      "start": 160.81,
      "end": 168.31,
      "text": "You're everything to me.",
      "source": "imported"
    },
    {
      "start": 168.31,
      "end": 172.02,
      "text": "Oh, my life,",
      "source": "imported"
    },
    {
      "start": 172.02,
      "end": 176.09,
      "text": "Is changing every day,",
      "source": "imported"
    },
    {
      "start": 176.09,
