  "lyrics": [
    {
      "start": 19.04,
      "end": 22.85,
      "text": "Woke up a little too rough",
      "source": "imported"
    },
    {
      "start": 22.85,
      "end": 26.79,
      "text": "Looking like a quarter when a dollar ain't enough",
      "source": "imported"
    },
    {
      "start": 26.79,
      "end": 29.47,
      "text": "This room is just a mess",
      "source": "imported"
    },
    {
      "start": 29.47,
      "end": 32.78,
      "text": "Nothing's ever working and I couldn't care less",
      "source": "imported"
    },
    {
      "start": 32.78,
      "end": 35.74,
      "text": "You know I ain't got no honey",
