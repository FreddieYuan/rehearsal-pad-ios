    },
    {
      "start": 52.949,
      "end": 55.81,
      "text": "無限大的數目",
      "source": "imported"
    },
    {
      "start": 55.81,
      "end": 59.903,
      "text": "狠已在你的心裡開始倒數",
      "source": "imported"
    },
    {
      "start": 59.903,
      "end": 61.966,
      "text": "一秒的倒數",
      "source": "imported"
    },
    {
      "start": 61.966,
      "end": 65.366,
      "text": "我不願是你第十五個耳洞",
      "source": "imported"
    },
    {
      "start": 65.366,
      "end": 68.374,
      "text": "我不要愛在你的世界告終",
      "source": "imported"
    },
    {
      "start": 68.374,
      "end": 72.655,
