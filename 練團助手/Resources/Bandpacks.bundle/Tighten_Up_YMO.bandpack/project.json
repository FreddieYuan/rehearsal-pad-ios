  "lyrics": [
    {
      "start": 21.6,
      "end": 25.92,
      "text": "I wanted love, I needed love",
      "source": "imported"
    },
    {
      "start": 25.92,
      "end": 30.95,
      "text": "Most of all, most of all",
      "source": "imported"
    },
    {
      "start": 30.95,
      "end": 34.64,
      "text": "Someone said true love was dead",
      "source": "imported"
    },
    {
      "start": 34.64,
      "end": 42.26,
      "text": "And I'm bound to fall, bound to fall for you",
      "source": "imported"
    },
    {
      "start": 42.26,
      "end": 47.94,
      "text": "Oh, what can I do? Yeah",
      "source": "imported"
    },
    {
      "start": 47.94,
      "end": 52.12,
      "text": "Take my badge but my heart remains",
      "source": "imported"
    },
    {
      "start": 52.12,
      "end": 56.11,
      "text": "Lovin' you, baby child",
      "source": "imported"
    },
    {
      "start": 56.11,
      "end": 60.51,
      "text": "Tighten up on your reins",
      "source": "imported"
    },
    {
      "start": 60.51,
      "end": 68.50999999999999,
      "text": "You are runnin' wild, runnin' wild, it's true",
      "source": "imported"
    },
    {
      "start": 86.52,
      "end": 91.2,
      "text": "Sick for days in so many ways",
      "source": "imported"
    },
    {
      "start": 91.2,
      "end": 96.03,
      "text": "I'm achin' now, I'm achin' now",
      "source": "imported"
    },
    {
      "start": 96.03,
      "end": 99.87,
      "text": "It's times like these I need relief",
      "source": "imported"
    },
    {
      "start": 99.87,
      "end": 107.87,
      "text": "Please show me how, oh show me how to get right",
      "source": "imported"
    },
    {
      "start": 108.05,
      "end": 113.28,
      "text": "Yeah, it's out of sight",
      "source": "imported"
    },
    {
      "start": 113.28,
      "end": 117.66,
      "text": "When I was young and movin' fast",
      "source": "imported"
    },
    {
      "start": 117.66,
      "end": 122.59,
      "text": "Nothin' slowed me down, oh, slowed me down",
      "source": "imported"
    },
    {
      "start": 122.59,
      "end": 127.77,
      "text": "Now I let the others pass, I've come around",
      "source": "imported"
    },
    {
      "start": 127.77,
      "end": 135.76999999999998,
      "text": "Oh come around, 'cause I've found",
      "source": "imported"
    },
    {
      "start": 165.49,
      "end": 168.03,
      "text": "Livin' just to keep goin'",
      "source": "imported"
    },
    {
      "start": 168.03,
      "end": 170.12,
      "text": "Goin' just to be sane",
      "source": "imported"
    },
    {
      "start": 170.12,
      "end": 172.82,
      "text": "All the while not knowin'",
      "source": "imported"
    },
    {
      "start": 172.82,
      "end": 175.26,
      "text": "It's such a shame",
      "source": "imported"
    },
    {
      "start": 175.26,
      "end": 177.06,
      "text": "I don't need to get steady",
      "source": "imported"
    },
    {
      "start": 177.06,
      "end": 179.95,
      "text": "I know just how I feel",
      "source": "imported"
    },
    {
      "start": 179.95,
      "end": 183.15,
      "text": "I'm tellin' you to be ready",
      "source": "imported"
    },
    {
      "start": 183.15,
      "end": 186.65,
      "text": "My dear",
      "source": "imported"
    }
  ],
